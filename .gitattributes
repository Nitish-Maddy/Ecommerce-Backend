# Auto-detect text files and normalize line endings
* text=auto

# Force LF for all source files (cross-platform consistency)
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.mjs   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binary files — don't touch
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
